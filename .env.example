# AI Proxy configuration (OpenAI-compatible router / provider)
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=
MODEL_CHAIN_FREE=cx/gpt-5.6-sol
AGENT_MODEL_ALLOWLIST=cx/gpt-5.6-sol

# Proxy receipt scanning: set to an approved vision-capable model alias.
RECEIPT_VISION_MODEL=

# Single-user personal mode: set both to true to disable daily quotas and chat rate limits.
# Remove or set to false before opening the proxy to multiple public users.
UNLIMITED_AI_TESTING=true
DISABLE_CHAT_RATE_LIMIT=true
